@page
@model CVAnalyzer.Pages.UploadModel

@{
    ViewData["Title"] = "CV Analyzer";
}

<style>
body {
    margin:0;
    padding:0;
    background:#f4f7fb;
    font-family:Segoe UI, sans-serif;
}

/* ===== Layout ===== */
.container {
    max-width:1000px;
    margin:20px auto;
    padding:15px;
}

/* ===== Cards ===== */
.card {
    background:white;
    padding:20px;
    border-radius:15px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    margin-bottom:20px;
}

/* ===== Heading ===== */
h1 {
    text-align:center;
    color:#1976d2;
    font-size:28px;
    margin-bottom:15px;
}

/* ===== Form ===== */
input[type=file] {
    width:100%;
    padding:12px;
    border-radius:10px;
    border:1px solid #ddd;
    font-size:14px;
}

button {
    width:100%;
    padding:14px;
    background:#1976d2;
    color:white;
    border:none;
    border-radius:10px;
    margin-top:10px;
    cursor:pointer;
    font-size:16px;
    transition:0.3s;
}

button:hover {
    background:#125aa0;
}

button:disabled {
    background:#90a4ae;
    cursor:not-allowed;
}

/* ===== Score Box ===== */
.score-box {
    text-align:center;
    padding:20px;
    background:linear-gradient(135deg,#1976d2,#42a5f5);
    color:white;
    border-radius:15px;
}

.score-number {
    font-size:55px;
    font-weight:bold;
}

/* ===== Badges ===== */
.badge {
    display:inline-block;
    padding:6px 10px;
    background:#1976d2;
    color:white;
    border-radius:20px;
    margin:5px;
    font-size:13px;
}

/* ===== Lists ===== */
ul {
    padding-left:20px;
}

li {
    margin-bottom:6px;
}

/* ===== Raw JSON ===== */
pre {
    background:#f5f5f5;
    padding:10px;
    border-radius:10px;
    overflow:auto;
}

/* ===== Loading Overlay ===== */
#loadingOverlay {
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.6);
    z-index:999;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    color:white;
    text-align:center;
}

.spinner {
    width:60px;
    height:60px;
    border:6px solid #ccc;
    border-top:6px solid #1976d2;
    border-radius:50%;
    animation:spin 1s linear infinite;
    margin-bottom:15px;
}

@@keyframes spin {
    100% { transform:rotate(360deg); }
}

/* ===== Mobile Responsive ===== */
@@media (max-width:768px) {
    h1 {
        font-size:22px;
    }

    .score-number {
        font-size:40px;
    }

    .container {
        padding:10px;
    }
}
</style>

<div class="container">

    <div class="card">
        <h1>📄 AI CV Analyzer</h1>

        <form method="post" enctype="multipart/form-data" id="uploadForm">
            <input type="file" asp-for="CvFile" />
            <button type="submit" id="submitBtn">🚀 Upload & Analyze</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p style="color:green">@Model.Message</p>
        }

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p style="color:red">@Model.Error</p>
        }
    </div>

    @if (Model.Score > 0)
    {
    <div class="card">

        <h2>📊 AI Analysis Result</h2>

        <div class="score-box">
            <h3>Overall Score</h3>
            <div class="score-number">@Model.Score</div>

            <div>
                @(Model.Score >= 80 ? "Excellent 🚀" :
                  Model.Score >= 60 ? "Good 👍" :
                  "Needs Improvement ⚠")
            </div>
        </div>

        <h3>🛠 Skills</h3>
        <div>
            @foreach (var s in Model.Skills)
            {
                <span class="badge">@s</span>
            }
        </div>

        <h3>💪 Strengths</h3>
        <ul>
            @foreach (var s in Model.Strengths)
            {
                <li>@s</li>
            }
        </ul>

        <h3>⚠ Weaknesses</h3>
        <ul>
            @foreach (var w in Model.Weaknesses)
            {
                <li>@w</li>
            }
        </ul>

        <h3>💡 Suggestions</h3>
        <ul>
            @foreach (var s in Model.Suggestions)
            {
                <li>@s</li>
            }
        </ul>

        <h3>📦 Raw JSON</h3>
        <pre>@Model.RawJson</pre>

    </div>
    }

</div>

<!-- ===== Loading Overlay ===== -->
<div id="loadingOverlay">
    <div class="spinner"></div>
    <h2>Analyzing CV...</h2>
    <p>Please wait while AI processes your resume</p>
</div>

<script>
document.getElementById("uploadForm").addEventListener("submit", function () {
    document.getElementById("loadingOverlay").style.display = "flex";
    document.getElementById("submitBtn").disabled = true;
});
</script>